+                $order->save();
+
+                Payment::query()
+                    ->where('order_id', $order->id)
+                    ->whereIn('status', ['created', 'authorized'])
+                    ->update([
+                        'status' => 'failed',
+                        'updated_at' => $now,
+                    ]);
+
