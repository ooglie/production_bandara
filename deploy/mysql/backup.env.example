# Install as /etc/bandara/backup.env with mode 600.
BANDARA_APP_DIR=/var/www/bandara/current
BANDARA_BACKUP_DIR=/var/backups/bandara
BANDARA_DB_NAME=bandarafrozen
BANDARA_MYSQL_CNF=/etc/bandara/mysql-backup.cnf
BANDARA_BACKUP_RETENTION_DAYS=14
# Enable only if the database actually contains these objects and the backup
# account has the additional privileges required by your MySQL version.
BANDARA_BACKUP_INCLUDE_ROUTINES=false
BANDARA_BACKUP_INCLUDE_EVENTS=false
