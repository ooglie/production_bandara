# Replace shop.example.com, certificate paths, application path, and PHP socket.
# Install under /etc/nginx/sites-available/bandara and enable it.

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    listen [::]:80;
    server_name shop.example.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
    }

    location / {
        return 301 https://shop.example.com$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name shop.example.com;

    root /var/www/bandara/current/public;
    index index.php;
    charset utf-8;
    server_tokens off;
    client_max_body_size 12m;

    ssl_certificate /etc/letsencrypt/live/shop.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/shop.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:BandaraTLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    access_log /var/log/nginx/bandara-access.log;
    error_log /var/log/nginx/bandara-error.log warn;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    # Publicly intended Laravel media only. Private ticket attachments never
    # use this path and remain behind authorized controller downloads.
    location ^~ /storage/ {
        try_files $uri =404;
        access_log off;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
    }

    location ^~ /build/ {
        try_files $uri =404;
        access_log off;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    error_page 404 /index.php;

    location ~ ^/index\.php(/|$) {
        fastcgi_pass unix:/run/php/php8.5-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_param HTTP_PROXY "";
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
        fastcgi_read_timeout 120s;
    }

    # Never execute arbitrary uploaded or misplaced PHP files.
    location ~ \.php$ {
        return 404;
    }

    # Deny hidden files except ACME validation.
    location ~ /\.(?!well-known).* {
        deny all;
    }

    # Defense in depth if a sensitive artifact is accidentally placed in public.
    location ~* /(\.env|composer\.(json|lock)|artisan|phpunit\.xml|.*\.(sql|bak|log|ini|conf))$ {
        deny all;
    }
}
