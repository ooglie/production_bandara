[Unit]
Description=Bandara database and uploaded-file backup
After=network.target mysql.service

[Service]
Type=oneshot
User=bandara
Group=www-data
WorkingDirectory=/var/www/bandara/current
Environment=BANDARA_BACKUP_CONFIG=/etc/bandara/backup.env
ExecStart=/var/www/bandara/current/scripts/backup_production.sh
Nice=10
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ReadOnlyPaths=/var/www/bandara/current
ReadWritePaths=/var/backups/bandara
