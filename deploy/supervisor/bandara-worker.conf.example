[program:bandara-worker]
process_name=%(program_name)s_%(process_num)02d
command=/usr/bin/php8.5 /var/www/bandara/current/artisan queue:work database --queue=default --sleep=3 --tries=3 --backoff=5 --timeout=90 --max-time=3600
directory=/var/www/bandara/current
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
user=bandara
numprocs=2
redirect_stderr=true
stdout_logfile=/var/www/bandara/current/storage/logs/worker.log
stdout_logfile_maxbytes=20MB
stdout_logfile_backups=5
stopwaitsecs=120
