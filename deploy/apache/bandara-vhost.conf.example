# Replace hostnames, certificate paths, application path, and PHP-FPM socket.

<VirtualHost *:80>
    ServerName shop.example.com
    Redirect permanent / https://shop.example.com/
</VirtualHost>

<VirtualHost *:443>
    ServerName shop.example.com
    DocumentRoot /var/www/bandara/current/public

    SSLEngine on
    SSLCertificateFile /etc/letsencrypt/live/shop.example.com/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/shop.example.com/privkey.pem
    SSLProtocol -all +TLSv1.2 +TLSv1.3

    LimitRequestBody 12582912
    ServerTokens Prod
    ServerSignature Off

    ErrorLog ${APACHE_LOG_DIR}/bandara-error.log
    CustomLog ${APACHE_LOG_DIR}/bandara-access.log combined

    <Directory /var/www/bandara/current/public>
        Options -Indexes -Includes -ExecCGI
        AllowOverride None
        Require all granted
        DirectoryIndex index.php
        FallbackResource /index.php
    </Directory>

    <FilesMatch "\.php$">
        Require all denied
    </FilesMatch>

    <Files "index.php">
        Require all granted
        SetHandler "proxy:unix:/run/php/php8.5-fpm.sock|fcgi://localhost/"
    </Files>

    <LocationMatch "^/(?:\.env|artisan|composer\.(?:json|lock)|phpunit\.xml)">
        Require all denied
    </LocationMatch>

    <DirectoryMatch "(^|/)\.(?!well-known)">
        Require all denied
    </DirectoryMatch>
</VirtualHost>
