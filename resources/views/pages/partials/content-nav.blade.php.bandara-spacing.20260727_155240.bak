    $items = [
        ['route' => 'content.about', 'label' => 'About Us'],
        ['route' => 'content.terms', 'label' => 'Terms & Conditions'],
        ['route' => 'content.privacy', 'label' => 'Privacy Policy'],
        ['route' => 'content.help', 'label' => 'Help & FAQs'],
