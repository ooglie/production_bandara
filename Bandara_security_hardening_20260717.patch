--- /dev/null
+++ b/scripts/update_frontend_security_dependencies.sh
@@ -0,0 +1,19 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+if [[ ! -f package.json || ! -f package-lock.json ]]; then
+    echo "Run this script from the Laravel project root." >&2
+    exit 1
+fi
+
+# Versions selected on 17 July 2026 to remain within the current compatible
+# major versions while moving beyond the vulnerable ranges reported by npm.
+npm install --save-dev --save-exact \
+    axios@1.18.1 \
+    concurrently@9.2.2 \
+    vite@7.3.4
+
+npm audit
