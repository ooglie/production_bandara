+<?php
+
+namespace App\Console\Commands;
+
+use Illuminate\Console\Command;
+
+class SecurityAuditConfig extends Command
+{
+    protected $signature = 'security:audit-config {--production : Enforce production release requirements}';
+    protected $description = 'Check application configuration for common insecure deployment settings';
+
+    public function handle(): int
+    {
+        $production = $this->option('production') || app()->environment('production');
+        $failures = [];
+        $warnings = [];
+
+        $appUrl = (string) config('app.url');
+        $appHost = strtolower((string) parse_url($appUrl, PHP_URL_HOST));
+        $trustedHosts = array_map('strtolower', (array) config('security.trusted_hosts', []));
+
+        if ($production && (bool) config('app.debug')) {
+            $failures[] = 'APP_DEBUG must be false in production.';
+        }
+
+        if (trim((string) config('app.key')) === '') {
+            $failures[] = 'APP_KEY is empty.';
+        }
+
+        if ($production && app()->environment() !== 'production') {
+            $failures[] = 'APP_ENV must be production for a production release.';
+        }
+
+        if ($production && ! str_starts_with($appUrl, 'https://')) {
+            $failures[] = 'APP_URL must use HTTPS in production.';
+        }
+
+        if ($production && config('session.secure') !== true) {
+            $failures[] = 'SESSION_SECURE_COOKIE must be true in production.';
+        }
+
+        if (config('session.http_only') !== true) {
+            $failures[] = 'SESSION_HTTP_ONLY must be true.';
+        }
+
+        if (! in_array(config('session.same_site'), ['lax', 'strict'], true)) {
+            $warnings[] = 'SESSION_SAME_SITE should normally be lax or strict.';
+        }
+
+        if ($production && config('session.encrypt') !== true) {
+            $warnings[] = 'SESSION_ENCRYPT is disabled.';
+        }
+
+        if ($trustedHosts === []) {
+            $failures[] = 'SECURITY_TRUSTED_HOSTS is empty.';
+        } elseif ($appHost !== '' && ! in_array($appHost, $trustedHosts, true)) {
+            $failures[] = 'SECURITY_TRUSTED_HOSTS must include the APP_URL hostname.';
+        }
+
+        foreach ($trustedHosts as $host) {
+            if (str_contains($host, '*') || str_contains($host, '/') || str_contains($host, '\\')) {
+                $failures[] = 'SECURITY_TRUSTED_HOSTS must contain exact hostnames only.';
+                break;
+            }
+        }
+
+        if ($production && (string) env('ADMIN_PASSWORD', '') !== '') {
+            $failures[] = 'Remove ADMIN_PASSWORD from the production environment after provisioning or rotating the administrator.';
+        }
+
+        if ($production && ! config('security.headers.hsts_enabled')) {
+            $warnings[] = 'SECURITY_HSTS_ENABLED is false. Enable it after HTTPS is verified.';
+        }
+
+        if ((string) config('mail.default') === 'log' && $production) {
+            $warnings[] = 'MAIL_MAILER is set to log in production.';
+        }
+
+        foreach ($warnings as $warning) {
+            $this->warn($warning);
+        }
+
+        foreach ($failures as $failure) {
+            $this->error($failure);
+        }
+
+        if ($failures !== []) {
+            $this->error('Security configuration audit failed.');
+            return self::FAILURE;
+        }
+
+        $this->info('Security configuration audit passed.');
+        return self::SUCCESS;
+    }
+}
