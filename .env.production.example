# Bandara Frozen — production environment template
# Copy to .env on the server, replace every CHANGE_ME value, then chmod 640.
# Never commit the populated .env file.

APP_NAME="Bandara Frozen"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://shop.example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_MAINTENANCE_DRIVER=file
APP_PREVIOUS_KEYS=

BCRYPT_ROUNDS=12

# Daily rotating logs; avoid debug level in production.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=daily
LOG_DEPRECATIONS_TRACE=false

# Use a dedicated runtime database account, never root.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bandarafrozen
DB_USERNAME=bandara_app
DB_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# For remote MySQL, provide the CA bundle and require encrypted transport at the server.
MYSQL_ATTR_SSL_CA=

# Durable state stores required by queues, locks, rate limits, and sessions.
CACHE_STORE=database
QUEUE_CONNECTION=database
QUEUE_AFTER_COMMIT=true
QUEUE_FAILED_DRIVER=database-uuids
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=120

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

BROADCAST_CONNECTION=log
# local points to storage/app/private; public media uses the explicit public disk.
FILESYSTEM_DISK=local

# Configure a real verified mail transport.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_EHLO_DOMAIN=shop.example.com
MAIL_FROM_ADDRESS=orders@example.com
MAIL_FROM_NAME="Bandara Frozen"

# Razorpay production credentials.
RAZORPAY_KEY_ID=CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME

# Google integrations. Restrict each key by API and server/browser origin.
GOOGLE_TRANSLATE_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_DISTANCE_MATRIX_API_KEY=
GOOGLE_MAPS_DISTANCE_MATRIX_API_KEY=
GOOGLE_GEOCODING_API_KEY=

# Exact hosts only. Add www.example.com only if it is intentionally served.
SECURITY_HEADERS_ENABLED=true
SECURITY_TRUSTED_HOSTS=shop.example.com
SECURITY_REDIRECT_HOSTS=shop.example.com
# Leave blank when Nginx/Apache talks directly to PHP-FPM. If TLS is terminated
# by a load balancer, list only its exact IP addresses/CIDR ranges; never use *.
SECURITY_TRUSTED_PROXIES=
SECURITY_PERMISSIONS_POLICY="camera=(), microphone=(), geolocation=(), payment=(self)"
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_VALUE="max-age=31536000"
# Start report-only. Review browser reports before enforcing a CSP.
SECURITY_CSP_REPORT_ONLY="default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://*.razorpay.com; script-src 'self' 'unsafe-inline' https://checkout.razorpay.com https://*.razorpay.com https://translate.google.com https://*.googleapis.com https://*.gstatic.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://*.googleapis.com https://*.gstatic.com; img-src 'self' data: blob: https:; font-src 'self' data: https://*.gstatic.com; connect-src 'self' https://*.razorpay.com https://*.googleapis.com; frame-src 'self' https://*.razorpay.com; worker-src 'self' blob:; upgrade-insecure-requests"

# Backups are required by the production preflight command.
BANDARA_BACKUP_REQUIRED=true
BANDARA_BACKUP_DIRECTORY=/var/backups/bandara
BANDARA_BACKUP_MAX_AGE_HOURS=26

# One-time administrator provisioning only. ADMIN_PASSWORD must remain blank
# except during the brief rotation/provisioning command.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PROMOTE_EXISTING_USER=false

# B2B pricing: never fall back to retail prices.
B2B_ALLOW_RETAIL_PRICE_FALLBACK=false
DEFAULT_GST_RATE=5
FALLBACK_MISSING_PRODUCT_GST_RATE=true
B2B_FORCE_DEFAULT_GST_WHEN_ZERO_RATE=true

# Delivery settings — copy the validated values from staging/current production.
STORE_PINCODE=411001
STORE_DELIVERY_ORIGIN_ADDRESS="CHANGE_ME"
STORE_DELIVERY_ORIGIN_LAT=
STORE_DELIVERY_ORIGIN_LNG=
DELIVERY_REQUIRE_SERVICEABLE_PINCODE=false
DELIVERY_DISTANCE_ENABLED=false
DELIVERY_DISTANCE_PROVIDER=google
DELIVERY_DISTANCE_REQUIRED=false
DELIVERY_DISTANCE_FALLBACK_TO_ZONE=true
DELIVERY_DISTANCE_TIMEOUT_SECONDS=6
DELIVERY_TAX_RATE=0
HANDLING_TAX_RATE=0
DELIVERY_HANDLING_TEMPERATURE_MODE=frozen
DELIVERY_SAC_CODE=996812
HANDLING_SAC_CODE=996721

# Rewards — copy the already-tested business values; B2B remains excluded.
BANDARA_CREDIT_ENABLED=false
BANDARA_CREDIT_SHADOW_MODE=true
BANDARA_CREDIT_EARN_ENABLED=false
BANDARA_CREDIT_REDEEM_ENABLED=false
BANDARA_CREDIT_AUTO_POST_ENABLED=false
BANDARA_CREDIT_REPEAT_BONUS_ENABLED=true
BANDARA_CREDIT_WELCOME_BONUS_ENABLED=true
BANDARA_CREDIT_BIRTHDAY_ENABLED=true
BANDARA_CREDIT_TIERS_ENABLED=true
BANDARA_CREDIT_ELIGIBILITY_MODE=role
BANDARA_CREDIT_ELIGIBILITY_COLUMN=customer_type
BANDARA_CREDIT_ELIGIBILITY_B2C_VALUE=b2c
BANDARA_CREDIT_PER_AMOUNT_SPENT=100
BANDARA_CREDIT_AMOUNT_PER_BLOCK=1
BANDARA_CREDIT_REPEAT_WINDOW_DAYS=10
BANDARA_CREDIT_WELCOME_AMOUNT=100
BANDARA_CREDIT_WELCOME_MIN_ORDER_VALUE=999
BANDARA_CREDIT_SILVER_THRESHOLD=0
BANDARA_CREDIT_GOLD_THRESHOLD=1000
BANDARA_CREDIT_PLATINUM_THRESHOLD=3500
BANDARA_CREDIT_SILVER_BIRTHDAY=100
BANDARA_CREDIT_GOLD_BIRTHDAY=150
BANDARA_CREDIT_PLATINUM_BIRTHDAY=200
BANDARA_CREDIT_NEXT_REWARD_AT=500
BANDARA_CREDIT_HISTORY_LIMIT=8
BANDARA_CREDIT_REDEEM_MINIMUM_POINTS=500
BANDARA_CREDIT_REDEEM_MAX_ORDER_PERCENTAGE=20
BANDARA_CREDIT_REDEEM_MINIMUM_PAYABLE_AMOUNT=1
BANDARA_CREDIT_RESERVATION_TTL_MINUTES=180
BANDARA_CREDIT_POINT_VALUE=1

VITE_APP_NAME="${APP_NAME}"
